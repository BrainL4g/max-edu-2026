# Шаблон переменных окружения SkillQuest.
# Скопируйте в .env (в корне репозитория или в backend/).

APP_NAME=SkillQuest
APP_ENV=development
DATABASE_URL=sqlite:///./skillquest.db
MAX_BOT_TOKEN=

# Публичный адрес API: попадает в servers OpenAPI и в заголовки Caddy.
PUBLIC_BASE_URL=http://localhost:8000

# Bearer-токен сервисной роли (роль service) для MAX-бота.
# Должен быть длинным и случайным; в Git не хранится.
SERVICE_API_TOKEN=

# Деплой за HTTPS (Caddy автоматически получает Let's Encrypt-сертификат).
SITE_ADDRESS=api.example.com
ACME_EMAIL=dev@example.com
# GigaChat (AI-оценка резюме).
# GIGACHAT_CREDENTIALS — Authorization key (то, что идёт после «Basic» в запросе
# POST https://ngw.devices.sberbank.ru:9443/api/v2/oauth). Access token клиент
# получает сам: он действует 30 минут и запрашивается повторно автоматически.
# GIGACHAT_ACCESS_TOKEN — необязательная альтернатива: готовый access token,
# подставляется в запросы Authorization: Bearer <token> без OAuth.
GIGACHAT_CREDENTIALS=
GIGACHAT_ACCESS_TOKEN=

# Необязательные настройки GigaChat:
# GIGACHAT_SCOPE=GIGACHAT_API_PERS   # GIGACHAT_API_PERS / _B2B / _CORP
# GIGACHAT_MODEL=GigaChat-3-Lightning  # список моделей: GET https://api.giga.chat/v1/models
#                                      # (GigaChat-2, GigaChat-2-Pro, GigaChat-3-Lightning, ...)
# GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_BASE_URL=https://api.giga.chat/v1
# GIGACHAT_VERIFY_SSL=true           # false — отключить проверку сертификата (локальная отладка)
# GIGACHAT_CA_BUNDLE=                # путь к CA-бандлу НУЦ Минцифры (нужен для api.giga.chat):
#   # curl -sk https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt -o root.pem
#   # curl -sk https://gu-st.ru/content/lending/russian_trusted_sub_ca_pem.crt -o sub.pem
#   # { cat root.pem; echo; cat sub.pem; echo; } > russian_trusted_ca.pem
#   # Значение нужно только для запуска вне Docker; в контейнере бэкенда путь
#   # задаёт образ (backend/Dockerfile, файл backend/gigachat/russian_trusted_ca.pem).
# GIGACHAT_TIMEOUT=30                # таймаут запросов к GigaChat, секунды

# Необязательные настройки (есть значения по умолчанию):
# AUTO_CREATE_TABLES=true   # создать таблицы при старте (прототип); production — Alembic
# SEED_ON_STARTUP=true      # наполнить базу демо-данными, если она пуста
# CORS_ORIGINS=*            # разрешённые origins через запятую (в prod перечислить явно)
