# Caddyfile — HTTPS-вход для SkillQuest API.
#
# Наружу открыт только Caddy (порты 80/443): backend слушает внутреннюю сеть
# и напрямую из интернета недоступен. Сертификат Let's Encrypt выпускается
# автоматически для SITE_ADDRESS (нужен реальный домен и проброс 80/443).
# Файлы сертификатов и ACME-челленджи живут в volume caddy_data.
# ACME_EMAIL обязателен для реального домена (Let's Encrypt пришлёт уведомления
# об истечении сертификата). Значение по умолчанию — заглушка, чтобы стек
# поднимался локально без .env.
{
	email {$ACME_EMAIL:hostmaster@example.com}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Ограничение тела запроса: файлы резюме — текстовые, 2 МБ с запасом.
	request_body {
		max_size 2MB
	}

	reverse_proxy backend:8000

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output stdout
		format json
	}
}
